<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ohm_localization</name>
  <version>0.1.0</version>
  <description>Monte-Carlo localization and ICP scan matching on the mecanum-lab simulator:
    the map layer, the particle filter, the ICP variants, four graded tasks and the nodes that
    run them (ASY2 practicum, Intelligente Robotik).</description>
  <maintainer email="pfitzner@example.com">pfitzner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The two message types this package publishes. The library itself needs only numpy and imports no
       ROS at all, which is what lets ./tools/run_lab.sh grade run on the in-process stub bus; a missing
       message package therefore must not be able to break the import of ohm_localization, and the nodes
       that need these types say so at start-up instead of at import time. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Not declared as a dependency on purpose: the simulator is a separate repository that is also built
       in this workspace, and a `<depend>mecanum_lab</depend>` here would make colcon order the two — which
       is right — but would also make this package uninstallable on its own, which is wrong: the grading
       path (tools/run_lab.sh) only needs the checkout on PYTHONPATH, and half the groups never touch ROS.
       ohm_localization.paths.mecanum_lab_root() finds it as a checkout or an install prefix, and
       install.sh --workspace builds both in the order they need. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
