<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ohm_localization</name>
  <version>0.1.0</version>
  <description>Monte-Carlo localization and ICP scan matching on the mecanum-lab simulator:
    the map layer, the particle filter, the ICP variants, four graded tasks and the nodes that
    run them (ASY2 practicum, Intelligente Robotik).</description>
  <maintainer email="pfitzner@example.com">pfitzner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- map_server publishes nav_msgs/OccupancyGrid; the library itself imports numpy and no ROS.
       The simulator is a separate checkout next door and is deliberately not a depend here. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
